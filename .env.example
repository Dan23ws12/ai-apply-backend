# ───── Server ─────
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (your frontend, if any)
CORS_ORIGINS=http://localhost:5173

# ───── Database (matches docker-compose.yml) ─────
DATABASE_URL="postgresql://jobapply:jobapply@localhost:5432/jobapply?schema=public"

# ───── Security ─────
# Long random string for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# 32-byte key (base64) that encrypts saved job-site credentials. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# ───── Job search APIs ─────
# JSearch (primary): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
# SerpApi Google Jobs (backup): https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# ───── Python AI / document service ─────
PYTHON_SERVICE_URL=http://127.0.0.1:8000
# Shared secret so only this API can call the Python service
PYTHON_SERVICE_TOKEN=change-me-too

# ───── Form auto-fill (Playwright) ─────
# Where the logged-in browser profile is kept (one sub-folder per user)
BROWSER_PROFILE_DIR=./storage/browser-profiles
# Prefer the company's own apply page over LinkedIn/Glassdoor when JSearch offers one (lower ban risk)
PREFER_DIRECT_APPLY=true
# How long (minutes) the filler keeps watching a form for new fields before it stops
AUTOFILL_WATCH_MINUTES=20
