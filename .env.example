# ───── Server ─────
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (your frontend, if any)
CORS_ORIGINS=http://localhost:5173

# ───── Database (matches docker-compose.yml) ─────
DATABASE_URL="postgresql://jobapply:jobapply@localhost:5432/jobapply?schema=public"

# ───── Security ─────
# Long random string for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Password reset link ({token} is replaced). Outside production the link is written to the API log.
PASSWORD_RESET_URL=http://localhost:5173/reset-password?token={token}
PASSWORD_RESET_TTL_MINUTES=60

# ───── Uploaded documents ─────
# Where uploaded resumes / cover letters are kept (git-ignored)
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=10
# How long a document preview / download link works
FILE_LINK_TTL_MINUTES=30
# 32-byte key (base64) that encrypts saved job-site credentials. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# ───── Job search APIs ─────
# JSearch (primary): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
# SerpApi Google Jobs (backup): https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# ───── Caching (cost control) ─────
# Hours a cached search stays usable; after that it starts again from page 1
SEARCH_CACHE_TTL_HOURS=24
# Only call the search API for a cached search when fewer than this many matching jobs are still open
SEARCH_REFRESH_THRESHOLD=20
# Most result pages kept per cached search
SEARCH_CACHE_MAX_PAGES=10
# Days fraud / match ratings are reused across users and re-runs
FRAUD_CACHE_TTL_DAYS=14
MATCH_CACHE_TTL_DAYS=30
# Bump to throw away every cached rating (e.g. after changing AI models or prompts)
EVALUATION_CACHE_VERSION=1
# Folder holding resumes/, shared-references/ and .agents/skills/ (edits there invalidate match ratings)
REFERENCES_ROOT=.

# ───── Python AI / document service ─────
PYTHON_SERVICE_URL=http://127.0.0.1:8000
# Shared secret so only this API can call the Python service
PYTHON_SERVICE_TOKEN=change-me-too

# ───── Form auto-fill (Playwright) ─────
# Where the logged-in browser profile is kept (one sub-folder per user)
BROWSER_PROFILE_DIR=./storage/browser-profiles
# Prefer the company's own apply page over LinkedIn/Glassdoor when JSearch offers one (lower ban risk)
PREFER_DIRECT_APPLY=true
# How long (minutes) the filler keeps watching a form for new fields before it stops
AUTOFILL_WATCH_MINUTES=20

# ───── Application log (Excel) ─────
# Each applied job is recorded straight away in a SQLite ledger; POST /api/application-logs
# exports the ledger to the Excel workbook (usually once at the end of the day).
# Relative paths start at this backend folder.
APPLICATION_LOG_PATH=../docs/AI Job Application Logs.xlsx
APPLICATION_LEDGER_PATH=./storage/application-ledger.sqlite
