# Claude API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Default model for every AI call
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = better but slower and more expensive)
AI_EFFORT_DOCUMENTS=high
AI_EFFORT_ANSWERS=medium

# ── Job post evaluation: two independent calls ──
# Fraud likelihood rating (runs first). Empty model = AI_MODEL.
AI_MODEL_FRAUD=claude-haiku-5-5
AI_EFFORT_FRAUD=medium
# Fraud check step 3: search for the company on LinkedIn with Claude's web search tool
# (about $0.01 per search, plus the search results as input tokens)
FRAUD_WEB_SEARCH=true
FRAUD_MAX_SEARCHES=5
# Fraud check steps 2 and 5: download the posting page to read it and check the site
FRAUD_FETCH_POSTING_PAGE=true
# Job match rating (skipped when the fraud rating is 80 or more). Empty model = AI_MODEL.
AI_MODEL_MATCH=claude-opus-5-5
AI_EFFORT_MATCH=medium

# Must match PYTHON_SERVICE_TOKEN in ../.env
PYTHON_SERVICE_TOKEN=change-me-too

# Repo root that holds .agents/skills, shared-references, resumes/ and application-docs/
# (relative paths are resolved from the python-service folder)
PROJECT_ROOT=..
# Where each application's folder is saved (relative paths are resolved from PROJECT_ROOT)
APPLICATION_DOCS_DIR=application-docs
