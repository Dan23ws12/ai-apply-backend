# Claude API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for scoring, resumes, cover letters and form answers
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = better but slower and more expensive)
AI_EFFORT_SCORING=low
AI_EFFORT_DOCUMENTS=high
AI_EFFORT_ANSWERS=medium

# Must match PYTHON_SERVICE_TOKEN in ../.env
PYTHON_SERVICE_TOKEN=change-me-too

# Repo root that holds .agents/skills, shared-references, resumes/ and cover-letters/
# (relative paths are resolved from the python-service folder)
PROJECT_ROOT=..
# Where generated documents are saved (relative paths are resolved from PROJECT_ROOT)
RESUME_OUTPUT_DIR=resumes/jb resumes
COVER_LETTER_OUTPUT_DIR=cover-letters
