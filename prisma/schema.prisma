// Prisma schema for the AI Job Apply app.
// Docs: https://pris.ly/d/prisma-schema
//
// Tables marked "SUGGESTED" were not in the original spec but are needed for the
// app to work well. See README.md > "Database schema" for the reasoning.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  OTHER
  UNKNOWN
}

enum JobLocationType {
  HYBRID
  REMOTE
  ON_SITE
  UNKNOWN
}

/// Where the job listing was found (the job board that published it).
enum SearchWebsite {
  LINKEDIN
  GLASSDOOR
  INDEED
  COMPANY_SITE
  OTHER
}

/// Which search API returned the job.
enum SearchProvider {
  JSEARCH
  SERPAPI
}

enum ApplicationStatus {
  FOUND // found; no resume or cover letter created yet
  SKIPPED // SUGGESTED: filtered out (blacklisted, low match, likely fraud)
  DOCUMENTS_READY // SUGGESTED: resume + cover letter generated
  SAVED // user saved the job for later
  FORM_FILLED // SUGGESTED: form auto-filled, waiting for the user to submit
  INCOMPLETE // application was started but not completed
  ERROR // an error occurred while processing
  APPLIED // user submitted the application
}

/// Search filter: only find jobs posted within this period.
/// (Jobs store the exact date in jobs.postedAt instead of a bucket.)
enum DatePostedRange {
  PAST_WEEK
  PAST_2_WEEKS
  PAST_MONTH
}

enum AnswerSource {
  PROFILE
  AI
  USER
}

/// Which AI evaluation a cached result belongs to.
enum EvaluationKind {
  FRAUD
  MATCH
}

enum AuditLogType {
  HTTP_REQUEST
  HTTP_RESPONSE
  EXTERNAL_API_CALL
  AI_CALL
  AUTOFILL
  AUTH
  ERROR
}

// ─────────────────────────────── Users ───────────────────────────────

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  /// Job-site credentials, ENCRYPTED with AES-256-GCM (see src/lib/crypto.ts).
  /// Shape after decryption: { linkedin?: {email, password}, glassdoor?: {email, password} }
  credentials  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile              UserProfile?
  settings             UserSettings?
  searchCriteria       SearchCriteria[]
  applications         Application[]
  answers              ApplicationAnswer[]
  auditLogs            AuditLog[]
  blacklistedCompanies Blacklisted[]

  @@map("users")
}

/// SUGGESTED: the data used to fill application forms. Kept apart from `users`
/// so login data and form-filling data change independently.
model UserProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  phone                 String?
  addressLine           String?
  city                  String?
  region                String? // province / state
  country               String?
  postalCode            String?
  linkedinUrl           String?
  githubUrl             String?
  portfolioUrl          String?
  workAuthorization     String? // e.g. "Canadian citizen", "Permanent resident"
  requiresSponsorship   Boolean?
  yearsOfExperience     Int?
  desiredSalary         String?
  noticePeriod          String? // e.g. "2 weeks"
  /// Which base resume to tailor: software_developer | data_analyst | business_analyst | non_it.
  /// Null = let the AI choose from the job description.
  defaultResumeCategory String?
  /// Free-form extra answers, e.g. { "pronouns": "...", "willing_to_relocate": "Yes" }
  extraAnswers          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// SUGGESTED: app settings, one row per user (created with defaults on first read).
/// A separate table (not a JSON column on `users`) so every setting has a type, a
/// default and a range check in the database, and a new setting is a normal migration.
model UserSettings {
  id             String   @id @default(uuid())
  userId         String   @unique
  /// Most new jobs one search run saves. Default 10.
  jobsPerSearch  Int      @default(10)
  /// Result pages one search API call asks for (about 10 jobs per page). Default 1.
  /// Each extra page costs extra API quota.
  pagesPerSearch Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// SUGGESTED: saved job criteria and filters. One user can have several searches.
model SearchCriteria {
  id               String            @id @default(uuid())
  userId           String
  name             String // e.g. "Remote data analyst roles"
  query            String // position keywords, e.g. "data analyst"
  location         String? // e.g. "Toronto, ON"
  country          String            @default("ca") // ISO 3166-1 alpha-2
  datePosted       DatePostedRange   @default(PAST_WEEK)
  jobTypes         JobType[]
  locationTypes    JobLocationType[]
  /// Only keep jobs listed on these sites. Default: LinkedIn + Glassdoor.
  websites         SearchWebsite[]   @default([LINKEDIN, GLASSDOOR])
  includeKeywords  String[]
  excludeKeywords  String[]
  minSalary        Int?
  minMatchRating   Int               @default(60) // 0-100
  maxFraudRating   Int               @default(40) // 0-100
  /// Optional override of user_settings.jobsPerSearch for this search. Null = use the user's setting.
  maxResults       Int?
  autoGenerateDocs Boolean           @default(true)
  isActive         Boolean           @default(true)
  lastRunAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@map("search_criteria")
}

// ───────────────────────────── Companies ─────────────────────────────

model Company {
  id                 String   @id @default(uuid())
  name               String
  /// Lower-case, punctuation-free name used to de-duplicate companies.
  normalizedName     String   @unique
  headOfficeLocation String?
  websiteUrl         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  postings      JobPosting[]
  blacklistedBy Blacklisted[]

  @@map("companies")
}

/// Companies each user never wants to apply to.
/// Deleting the user or the company deletes its rows here (onDelete: Cascade).
model Blacklisted {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("blacklisted")
}

// ──────────────────────────────── Jobs ───────────────────────────────
//
// A job is split in two so every table is in third normal form:
//   job_postings  = facts about the posting itself, shared by every user who finds it
//                   (title, description, salary, fraud rating, ...). Key: externalId.
//   applications  = one user's application to one posting (status, dates, match rating,
//                   documents). Key: (userId, postingId).
// Saved, applied and every other status stay in `applications`: the status is a column,
// and application_status_events keeps the history of changes.

/// SUGGESTED: one row per job posting found by any search, shared by all users.
/// Postings are kept when companies or users are deleted.
model JobPosting {
  id               String          @id @default(uuid())
  /// The job ID from JSearch / SerpApi (prefixed "jsearch:" / "serpapi:"), so the same posting is stored once.
  externalId       String          @unique
  provider         SearchProvider
  companyId        String?
  /// The company name as the posting shows it. Kept when the company row is deleted.
  companyName      String
  positionName     String
  description      String?         @db.Text
  location         String?
  jobType          JobType         @default(UNKNOWN)
  locationType     JobLocationType @default(UNKNOWN)
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?
  salaryPeriod     String?
  /// When the job was posted (null when the search API did not say).
  postedAt         DateTime?
  /// Optional. 1-100: likelihood the posting is a scam or fake (higher = more likely).
  /// A fact about the posting, so it is rated once for everyone.
  fraudRating      Int?
  fraudReason      String?         @db.Text
  /// Red flags with weights, LinkedIn / domain / posting-site checks.
  fraudDetails     Json?
  fraudEvaluatedAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applyOptions JobApplyOption[]
  applications Application[]

  @@index([companyId])
  @@map("job_postings")
}

/// SUGGESTED: every apply link the search API returned for a posting (one row per link
/// instead of a JSON list, so each value is atomic and an application can point at one).
model JobApplyOption {
  id        String        @id @default(uuid())
  postingId String
  /// Publisher name as the API gave it, e.g. "LinkedIn" or "Acme Careers".
  publisher String
  url       String        @db.Text
  /// True when the link is the employer's own careers page.
  isDirect  Boolean       @default(false)
  website   SearchWebsite @default(OTHER)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  posting      JobPosting    @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([postingId, url])
  @@map("job_apply_options")
}

/// One user's application to one posting: found, saved, applied, skipped and so on all live here.
/// Kept when the user is deleted: userId is set to NULL (application history).
/// The API still calls these "jobs" (/api/jobs/:id uses this id).
model Application {
  id                String            @id @default(uuid())
  userId            String?
  postingId         String
  searchCriteriaId  String?
  /// The apply link this application uses (company site preferred when PREFER_DIRECT_APPLY).
  applyOptionId     String
  /// The job board this user found the posting on (from their search's websites).
  /// Not always the apply link's site: a LinkedIn listing can apply on the company site.
  searchWebsite     SearchWebsite     @default(OTHER)
  /// Optional. 1-100: how well the posting matches the resumes (higher = better). Per user because it
  /// uses the user's preferred resume track. Skipped when the posting's fraudRating >= 80.
  matchRating       Int?
  matchReason       String?           @db.Text
  /// Chosen resume track, keywords to add, part scores, caps. Null when the match rating was skipped.
  matchDetails      Json?
  applicationStatus ApplicationStatus @default(FOUND)
  /// Last error or status note, e.g. why the application was skipped.
  statusMessage     String?           @db.Text
  /// When the user submitted the application (status APPLIED).
  applicationDate   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user             User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  posting          JobPosting               @relation(fields: [postingId], references: [id], onDelete: Restrict)
  searchCriteria   SearchCriteria?          @relation(fields: [searchCriteriaId], references: [id], onDelete: SetNull)
  applyOption      JobApplyOption           @relation(fields: [applyOptionId], references: [id], onDelete: Restrict)
  applicationFiles ApplicationFile?
  statusEvents     ApplicationStatusEvent[]

  @@unique([userId, postingId])
  @@index([userId, applicationStatus])
  @@index([postingId])
  @@index([searchCriteriaId])
  @@map("applications")
}

/// SUGGESTED: append-only history of status changes (e.g. saved on Monday, applied on Thursday).
/// No updatedAt because rows are never changed.
model ApplicationStatusEvent {
  id            BigInt             @id @default(autoincrement())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  message       String?            @db.Text
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_status_events")
}

// ────────────────────────── Application files ─────────────────────────

model ApplicationFile {
  id                 String   @id @default(uuid())
  applicationId      String   @unique
  /// Resume used for the application. Defaults to the AI-generated file; the user can change it.
  resumeLink         String?
  coverLetterLink    String?
  /// SUGGESTED: originals produced by the AI, kept so the user can switch back.
  aiResumeLink       String?
  aiCoverLetterLink  String?
  /// SUGGESTED: which base resume was tailored and which keywords were added.
  baseResumeCategory String?
  keywordsUsed       String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_files")
}

/// SUGGESTED: saved answers to application questions ("Are you legally
/// allowed to work in Canada?") so the AI is only asked each question once
/// and the user can correct an answer for every future application.
model ApplicationAnswer {
  id           String       @id @default(uuid())
  userId       String
  /// sha256 of the normalised question text.
  questionHash String
  question     String       @db.Text
  answer       String       @db.Text
  source       AnswerSource @default(AI)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionHash])
  @@map("application_answers")
}

// ─────────────────────────────── Caches ──────────────────────────────

/// SUGGESTED: search API results shared by all users. Job postings are public, so two
/// users running the same search reuse one API call. Key = sha256 of the normalised
/// search parameters (query, location, country, date range, remote, job types).
model SearchCache {
  id            String         @id @default(uuid())
  cacheKey      String         @unique
  /// The normalised parameters the key was made from (for debugging).
  params        Json
  /// Provider that produced the cached pages. Top-ups use the same provider.
  provider      SearchProvider
  /// NormalizedJob[] from every page fetched so far.
  jobs          Json
  pagesFetched  Int            @default(0)
  /// SerpApi token for the next page (JSearch uses page numbers).
  nextPageToken String?        @db.Text
  /// True when the provider has no more pages for this search.
  exhausted     Boolean        @default(false)
  apiCalls      Int            @default(0)
  hitCount      Int            @default(0)
  /// After this the entry is ignored and the search starts again from page 1.
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([expiresAt])
  @@map("search_cache")
}

/// SUGGESTED: fraud and match results shared by all users and re-runs.
/// FRAUD key = sha256(posting fields sent to /evaluate/fraud + rules fingerprint).
/// MATCH key = sha256(posting fields sent to /evaluate/match + preferred track + resumes/rules fingerprint).
/// Editing a base resume, skill or reference file changes the fingerprint, so old results stop matching.
model EvaluationCache {
  id        String         @id @default(uuid())
  kind      EvaluationKind
  cacheKey  String
  /// The validated FraudResult / MatchResult from the Python service.
  result    Json
  hitCount  Int            @default(0)
  expiresAt DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([kind, cacheKey])
  @@index([expiresAt])
  @@map("evaluation_cache")
}

// ───────────────────────────── Audit logs ────────────────────────────

/// Append-only developer log. No updatedAt because rows are never changed.
model AuditLog {
  id         BigInt       @id @default(autoincrement())
  type       AuditLogType
  userId     String?
  /// Ties an HTTP request to its response and to the API calls it made.
  requestId  String?
  method     String?
  url        String?      @db.Text
  statusCode Int?
  durationMs Int?
  message    String?      @db.Text
  /// Extra details. Secrets are removed before saving (see src/lib/redact.ts).
  metadata   Json?
  createdAt  DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([requestId])
  @@index([userId])
  @@map("audit_logs")
}
